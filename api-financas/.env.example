# Spring Boot does not load this file automatically. Export these variables in
# the shell/IDE or configure them in the hosting provider.
DB_URL=jdbc:postgresql://localhost:5432/financeiro_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=900000
REFRESH_SESSION_MS=86400000
REFRESH_REMEMBER_MS=2592000000
# false apenas para localhost/HTTP; true é obrigatório em produção/HTTPS.
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:4200
HIBERNATE_DDL_AUTO=validate
JPA_SHOW_SQL=false
FLYWAY_BASELINE_ON_MIGRATE=false
# Use 0 somente na primeira migração do banco legado com apenas tb_usuarios.
FLYWAY_BASELINE_VERSION=1
